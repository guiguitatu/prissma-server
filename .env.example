# Copie para `.env` na raiz do projeto e preencha os valores.
# O `.env` e lido pelo spring-dotenv no start e NAO vai para o repositorio.
# Nunca versione credenciais reais.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Uma unica connection string e suficiente.
#
# Desenvolvimento local:
DATABASE_URL=postgresql://prissma:prissma@localhost:5432/prissma
#
# Neon / Cloud Run (exemplo):
# DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xxxx-pooler.region.aws.neon.tech/prissma?sslmode=require&channel_binding=require

# ---------------------------------------------------------------------------
# Seguranca / aplicacao
# ---------------------------------------------------------------------------
JWT_SECRET=
# JWT_EXPIRATION=86400000
APP_ADMIN_EMAIL=admin@prissma.com
APP_ADMIN_PASSWORD=
APP_ADMIN_NAME=Admin
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
# Sem OPENAI_API_KEY a geracao de imagens responde 503; o restante da aplicacao
# continua subindo normalmente.
OPENAI_API_KEY=

# Opcionais - so preencha para apontar para outro endpoint ou modelo.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_MAX_INPUT_BYTES=20971520
